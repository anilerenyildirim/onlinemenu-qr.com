---
/**
 * İletişim — doğrudan kanallar + teklif formu.
 *
 * GEÇİCİ: /api/contact (D1 + Turnstile + Resend) aşama 3'te yazılana kadar form,
 * doğrulanmış talebi WhatsApp mesajı olarak iletir (app.ts → initContactForm).
 */
import { site, whatsappHref } from '../data/site';
import { serviceOptions } from '../data/services';
---

<section id="iletisim" class="contact" aria-labelledby="iletisim-title">
  <div class="container-x contact-grid">
    <div class="contact-intro" data-reveal>
      <h2 id="iletisim-title" class="section-title">Teklif alın</h2>
      <p class="contact-lede">Formu doldurun, işletmenize uygun kapsamla size dönelim. Beklemek istemezseniz doğrudan arayın ya da WhatsApp'tan yazın.</p>

      <div class="channels">
        <p class="channels-label">Bize ulaşın</p>
        <ul role="list" class="phones">
          {
            site.phones.map((phone) => (
              <li>
                <a href={`tel:+${phone.e164}`}>{phone.display}</a>
              </li>
            ))
          }
        </ul>
        <a href={`mailto:${site.email}`} class="mail">{site.email}</a>

        <a href={whatsappHref} class="btn btn-ghost whatsapp" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"
            ></path>
          </svg>
          WhatsApp'tan yazın
          <span class="sr-only">(yeni sekmede açılır)</span>
        </a>
      </div>
    </div>

    <form class="form" action="/api/contact" method="post" novalidate data-contact-form data-wa={site.whatsapp.phone.e164} data-reveal>
      <div class="field">
        <label for="f-name">Ad soyad <span aria-hidden="true">*</span></label>
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" />
      </div>

      <div class="field">
        <label for="f-business">İşletme adı <span aria-hidden="true">*</span></label>
        <input id="f-business" name="business" type="text" autocomplete="organization" required maxlength="120" />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-phone">Telefon <span aria-hidden="true">*</span></label>
          <input
            id="f-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            placeholder="05xx xxx xx xx"
            aria-describedby="f-phone-hint"
          />
          <p id="f-phone-hint" class="hint">Türkiye cep veya sabit hat</p>
        </div>

        <div class="field">
          <label for="f-email">E-posta <span class="optional">(opsiyonel)</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" maxlength="160" />
        </div>
      </div>

      <fieldset class="field">
        <legend>İlgilendiğiniz hizmetler</legend>
        <div class="chips">
          {
            serviceOptions.map((option) => (
              <label class="chip">
                <input type="checkbox" name="services" value={option.id} />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field">
        <label for="f-message">Mesaj</label>
        <textarea id="f-message" name="message" rows="4" maxlength="2000"></textarea>
      </div>

      <label class="consent">
        <input type="checkbox" name="kvkk" value="1" required />
        <span>
          <a href="/kvkk/" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>'ni okudum; bilgilerimin teklif amacıyla işlenmesini kabul ediyorum. <span aria-hidden="true">*</span>
        </span>
      </label>

      <div class="submit-row">
        <button type="submit" class="btn btn-primary submit">Teklif İste</button>
        <p class="hint">Talebiniz WhatsApp üzerinden bize iletilir.</p>
      </div>
      <p class="form-status" role="status" aria-live="polite" data-form-status hidden></p>
    </form>
  </div>
</section>

<style>
  .contact {
    padding-block: 5.5rem;
  }
  .contact-grid {
    display: grid;
    gap: 3rem;
  }

  .contact-lede {
    margin-top: 1.25rem;
    max-width: 30rem;
    color: var(--color-muted);
  }

  .channels {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
  .channels-label {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .phones {
    margin-top: 0.75rem;
  }
  .phones a {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .phones a:hover,
  .mail:hover {
    color: var(--color-accent);
  }
  .mail {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-muted);
    transition: color 0.25s ease;
  }
  .whatsapp {
    display: flex;
    width: fit-content;
    margin-top: 1.75rem;
  }

  .form {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background: var(--color-surface);
  }
  .field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .field-row {
    display: grid;
    gap: 1.25rem;
  }
  label,
  legend {
    font-size: 0.875rem;
    font-weight: 600;
  }
  legend {
    margin-bottom: 0.5rem;
  }
  label [aria-hidden],
  .consent [aria-hidden] {
    color: var(--color-accent);
  }
  .optional,
  .hint {
    font-weight: 400;
    color: var(--color-muted);
  }
  .hint {
    font-size: 0.8125rem;
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.75rem;
    background: var(--color-bg);
    color: var(--color-text);
    /* iOS zoom'u engellemek için ≥16px */
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }
  textarea {
    resize: vertical;
  }
  input::placeholder {
    color: color-mix(in oklab, var(--color-muted) 70%, transparent);
  }
  input:hover,
  textarea:hover {
    border-color: var(--color-muted);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: transparent;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
    font-weight: 500;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .chip:hover span {
    border-color: var(--color-muted);
  }
  .chip input:checked + span {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .consent input {
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
  }
  .consent a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .submit {
    min-width: 10rem;
  }
  .form-status {
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    font-size: 0.9375rem;
  }
  .form-status[data-tone='error'] {
    border-color: #e5a3a3;
  }
  [aria-invalid='true'] {
    border-color: #e5a3a3;
  }

  @media (min-width: 640px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .contact {
      padding-block: 8rem;
    }
    .contact-grid {
      grid-template-columns: 5fr 6fr;
      gap: 5rem;
      align-items: start;
    }
    .form {
      padding: 2.25rem;
    }
  }
</style>
