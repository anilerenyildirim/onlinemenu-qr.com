---
import Wordmark from './Wordmark.astro';
import { alternatesOf, langOf, routes, t } from '../i18n';

const lang = langOf(Astro.url);
const ui = t(lang);
const home = routes.home[lang];
const other = lang === 'tr' ? 'en' : 'tr';
// Karşılığı olmayan sayfada (kvkk, 404) diğer dilin ana sayfası
const otherHref = (alternatesOf(Astro.url) ?? routes.home)[other];

const links = [
  { href: routes.qrMenu[lang], label: ui.nav.qrMenu },
  { href: routes.nfc[lang], label: ui.nav.nfc },
  { href: `${home}#${ui.anchors.faq}`, label: ui.nav.faq },
  { href: `${home}#${ui.anchors.contact}`, label: ui.nav.contact },
];
---

<header class="site-header" data-header>
  <div class="container-x header-row">
    <Wordmark href={home} />

    <nav aria-label={ui.nav.label} class="header-nav">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={otherHref} class="lang-switch" hreflang={ui.langSwitch.hreflang} lang={ui.langSwitch.hreflang} aria-label={ui.langSwitch.title}>
        {ui.langSwitch.label}
      </a>
      <a href={`${home}#${ui.anchors.contact}`} class="btn btn-primary btn-sm">{ui.cta}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      backdrop-filter 0.35s ease;
  }
  .site-header[data-scrolled] {
    background: color-mix(in oklab, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--color-line);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .header-nav {
    display: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lang-switch {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    transition: color 0.25s ease;
  }
  .lang-switch:hover {
    color: var(--color-text);
  }
  /* Dar telefonlarda wordmark + dil + CTA tek satıra sığsın */
  @media (max-width: 399px) {
    .header-actions {
      gap: 0.125rem;
    }
    .lang-switch {
      min-width: 2.25rem;
    }
  }
  .header-nav ul {
    display: flex;
    gap: 2.25rem;
  }
  .header-nav a {
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-muted);
    transition: color 0.25s ease;
  }
  .header-nav a:hover {
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .header-row {
      height: 4.75rem;
    }
  }
  @media (min-width: 1024px) {
    .header-nav {
      display: block;
    }
  }
</style>
