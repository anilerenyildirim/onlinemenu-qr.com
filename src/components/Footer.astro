---
import Wordmark from './Wordmark.astro';
import { site, siteCopy, whatsappHref } from '../data/site';
import { servicePages } from '../data/pages';
import { langOf, t } from '../i18n';

const lang = langOf(Astro.url);
const ui = t(lang);
const parentLink = `<a href="${site.parent.url}" target="_blank" rel="noopener">${site.parent.name}</a>`;
---

<footer class="footer">
  <div class="container-x">
    <div class="footer-top">
      <div class="footer-brand">
        <Wordmark />
        <p class="footer-tag">{ui.footer.tag} {siteCopy[lang].serviceArea.short}</p>
      </div>

      <ul role="list" class="footer-links">
        {
          servicePages[lang].map((page) => (
            <li>
              <a href={page.path}>{page.breadcrumb}</a>
            </li>
          ))
        }
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.phones.map((phone) => (
            <li>
              <a href={`tel:+${phone.e164}`}>{phone.display}</a>
            </li>
          ))
        }
        <li>
          <a href={whatsappHref(lang)} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> {ui.newTab}</span></a>
        </li>
        <li><a href="/kvkk/" hreflang="tr">{ui.footer.kvkk}</a></li>
      </ul>
    </div>

    <div class="footer-bottom">
      <p>{site.legalName} · {ui.footer.legalForm}</p>
      <p set:html={ui.footer.parent(parentLink)} />
      <p>© {site.copyrightYear} onlinemenu-qr. {ui.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3.5rem 2.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
  }
  .footer-top {
    display: grid;
    gap: 2rem;
  }
  .footer-tag {
    margin-top: 1rem;
    max-width: 22rem;
    color: var(--color-muted);
  }
  .footer-links {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .footer-links a,
  .footer-bottom a {
    color: var(--color-muted);
    transition: color 0.25s ease;
  }
  .footer-links a:hover,
  .footer-bottom a:hover {
    color: var(--color-text);
  }
  .footer-bottom a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    display: grid;
    gap: 0.375rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr auto;
    }
    .footer-links {
      text-align: right;
    }
  }
</style>
