---
/**
 * Ana sayfa JSON-LD — işletme, site, hizmetler ve SSS.
 * type="application/ld+json" çalıştırılabilir script değildir; CSP'den etkilenmez.
 *
 * LocalBusiness yerine Organization: LocalBusiness açık adres ister, adres henüz yok.
 */
import { site, siteCopy } from '../data/site';
import { showcase, services } from '../data/services';
import { homeFaq } from '../data/faq';
import { servicePages } from '../data/pages';
import { ORG_ID, WEBSITE_ID, abs, areaServed, faqPage, jsonLd } from '../lib/schema';
import { langOf, langs, locale, routes, t } from '../i18n';

const lang = langOf(Astro.url);
const ui = t(lang);
const home = abs(routes.home[lang]);
const area = areaServed(lang);
const pageFor = (id: string) => servicePages[lang].find((p) => p.serviceId === id);

const graph = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: site.name,
    url: home,
    logo: { '@type': 'ImageObject', url: abs('/icon-512.png'), width: 512, height: 512 },
    image: abs('/og.jpg'),
    description: siteCopy[lang].description,
    email: site.email,
    telephone: `+${site.phones[0]!.e164}`,
    legalName: site.legalName,
    areaServed: area,
    contactPoint: site.phones.map((phone) => ({
      '@type': 'ContactPoint',
      telephone: `+${phone.e164}`,
      contactType: 'sales',
      areaServed: area,
      // TEYİT: İngilizce görüşme yapılıyorsa 'English' eklenebilir.
      availableLanguage: ['Turkish'],
    })),
    parentOrganization: { '@type': 'Organization', name: site.parent.name, url: site.parent.url },
    knowsAbout:
      lang === 'tr'
        ? ['QR menü', 'Dijital menü', 'Karekod menü', 'NFC Google yorum standı', 'Restoran web sitesi']
        : ['QR code menu', 'Digital menu', 'Contactless menu', 'NFC Google review stand', 'Restaurant website'],
    // TEYİT: Instagram / Google İşletme Profili bağlantıları eklenecek.
    sameAs: [],
  },
  {
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    url: abs('/'),
    name: site.name,
    inLanguage: langs.map((l) => locale[l].bcp47),
    publisher: { '@id': ORG_ID },
  },
  {
    '@type': 'WebPage',
    '@id': home,
    url: home,
    name: siteCopy[lang].title,
    description: siteCopy[lang].description,
    inLanguage: locale[lang].bcp47,
    isPartOf: { '@id': WEBSITE_ID },
  },
  ...[...showcase[lang], ...services[lang]].map((item) => {
    const page = pageFor(item.id);
    return {
      '@type': 'Service',
      '@id': page ? `${abs(page.path)}#service` : `${home}#${item.id}`,
      name: item.title,
      description: item.body,
      provider: { '@id': ORG_ID },
      areaServed: area,
      url: page ? abs(page.path) : `${home}#${ui.anchors.services}`,
    };
  }),
  faqPage(lang, home, homeFaq[lang]),
];
---

<script is:inline type="application/ld+json" set:html={jsonLd(graph)} />
